---
// The character companion: build your own or pick one of the crew, and play
// them from your phone.
// src/companion/app.js draws everything from the crew's sheets, which the
// build reads straight off the rules (scripts/build-content.mjs). Characters
// are saved on the phone, and the service worker keeps this page offline.
import Base from "../../layouts/Base.astro";
import book from "../../generated/book.json";
import "@fontsource/alegreya-sans/800.css";
import "../../styles/kit.css";
import "../../styles/companion.css";

const data = { crew: book.crew, conditions: book.companion.conditions, links: book.companion.links, build: book.companion.build, rules: book.companion.rules };
const json = JSON.stringify(data).replace(/</g, "\\u003c");
---
<Base title="Characters" current="characters" description="Build your own Zi’Dara character or play one of the crew from your phone, with the counting done and every roll a tap away.">
  <script is:inline slot="head">
    // A link straight to a sheet or the learning round hides the crew list until
    // it's drawn, and a character or the builder opens full screen, without the
    // site's bar.
    try {
      if (/[?&](c=|build\b|learn\b)/.test(location.search)) document.documentElement.classList.add("cc-open");
      if (/[?&](c=|build\b)/.test(location.search)) document.documentElement.classList.add("cc-full");
    } catch (e) {}
  </script>
  <main id="main" class="companion frame">
    <div id="app" class="cc">
      <header class="cc-intro">
        <p class="kicker">Your phone at the table</p>
        <h1>Characters</h1>
        <p class="lede">Build your own or pick one of the crew, and play them from your phone. The counting’s done for you, and they’re saved on this phone, signal or not.</p>
        <p class="cc-paper">Playing on paper? Print a character sheet and the player reference from the <a href="/sheets/">Sheets page</a>.</p>
      </header>
      <noscript><div class="cc-note is-warn"><p>The companion needs JavaScript. The crew’s full sheets are in the <a href={book.crewLink}>rules</a>.</p></div></noscript>
      <section class="cc-sec cc-static" aria-labelledby="cc-crew">
        <h2 id="cc-crew">Pick from the crew</h2>
        <div class="crew">
          {book.crew.map((c) => (
            <article class="card">
              <div class="art"><span class="die" aria-hidden="true">{c.name[0]}</span></div>
              <div class="body">
                <h3>{c.name}</h3>
                <p class="title">{c.title}</p>
                <div class="chips">{c.archetypes.map((a) => <span class="chip">{a}</span>)}</div>
                <p class="blurb">{c.blurb}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
    <dialog id="cc-dialog" class="cc-dialog"></dialog>
    <div id="cc-toast" class="cc-toast" role="status" aria-live="polite"></div>
  </main>
  <script is:inline type="application/json" id="zi-companion" set:html={json}></script>
  <script>
    import "../../companion/app.js";
  </script>
</Base>
