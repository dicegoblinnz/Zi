---
// The kit: every game object, drawn once in the Struck look Mo picked on
// 26 Oct (notes/design-26oct.md, Piece 1), on the current rules. It reads the
// crew off the chapter, like the companion does, so every number here is the
// book's. Not linked from anywhere, and kept out of search and the offline
// cache.
import "@fontsource/cinzel/600.css";
import "@fontsource/cinzel/700.css";
import "@fontsource/alegreya-sans/400.css";
import "@fontsource/alegreya-sans/400-italic.css";
import "@fontsource/alegreya-sans/700.css";
import "@fontsource/alegreya-sans/700-italic.css";
import "@fontsource/alegreya-sans/800.css";
import "../styles/site.css";
import "../styles/kit.css";
import book from "../generated/book.json";
import { die, diceFor, inline, pips, aura, scars, boxes, condition, tag, crest, telegraph, cost, seal, glyph, DEFS, SIGILS, SHAPES, SIZES, CHARGES, FIELDS, MARKS, GLYPHS } from "../kit/kit.js";
import { diceLabel, stepsToDice } from "../companion/dice.js";
import { withQuality } from "../companion/armour.js";
import { rootFor, rootsSheet, specSteps } from "../companion/roots.js";

const crew = Object.fromEntries(book.crew.map((c) => [c.id, rootsSheet(c, [], book.companion.build)]));
const archOf = (c) => c.archetypes.map((a) => a.name);
const archNames = (c) => [...c.archetypes.reduce((m, a) => m.set(a.name, (m.get(a.name) ?? 0) + 1), new Map())].map(([x, k]) => (k > 1 ? `${x} twice` : x));
const ARCH = book.companion.build.archetypes;
for (const a of ARCH) if (!SIGILS[a.name]) throw new Error(`The kit has no sigil for ${a.name}. Draw one in src/kit/sigils.js.`);
const vesk = crew.vesk;
const n = vesk.numbers;
const order = ["vesk", "dorrie", "bram", "isolde", "wren", "ash"];
// Each specialty as a roll on the Root it's usually rolled with.
const tilesOf = (c) => c.specialties.map((sp) => ({ name: sp.name, root: rootFor(c, sp.name), steps: c.roots[rootFor(c, sp.name)] + sp.steps, spec: sp.steps }));
// Vesk at the vault door: her Body and her Locks, with her picks.
const lock = { body: vesk.roots.Body, locks: specSteps(vesk, "Locks") };
lock.steps = lock.body + lock.locks + 1;
// Bram talks his way past the gate: his Soul and his Command, a d8.
const talk = crew.bram.roots.Soul + specSteps(crew.bram, "Command");
// Wren and Bram on the brute's club: her Body, her Archery and her longbow,
// and his Shieldwork and his hammer.
const wrenShot = crew.wren.roots.Body + specSteps(crew.wren, "Archery") + 1;
const bramIn = specSteps(crew.bram, "Shieldwork") + 1;
const combo = wrenShot + bramIn;
// Bram Defends: his Body and his Shieldwork, with his plate and his shield.
// The Core's own example: Vesk over the roof, and Bram making a case for his
// Soldiering.
const roof = vesk.roots.Body + specSteps(vesk, "Stealth");
const chase = crew.bram.roots.Body + specSteps(crew.bram, "Soldiering");
const bramDefend = crew.bram.roots.Body + specSteps(crew.bram, "Shieldwork") + crew.bram.armour.filter((a) => a.root === "Body").length;
// Seals (stage 1 of notes/faction-feel-plan.md): every charge with the kinds
// of faction the builder deals it to, every field and mark, the Brinewake's
// board as the book has it, and the faction turn's glyphs with the book's
// words for each.
const KINDS = { house: "noble houses", traders: "merchant guilds", crooks: "street gangs", faith: "temples and orders", office: "crown offices", society: "secret societies", soldiers: "mercenaries", makers: "craft guilds", family: "family businesses", rebels: "rebels", keepers: "keepers of old things", old: "old things with human faces" };
const kindsOf = (c) => (c.kinds.length ? c.kinds.map((k) => KINDS[k] ?? k).join(", ").replace(/^./, (x) => x.toUpperCase()) : "Only a whole world's, or the GM's pick");
// Four seals on a board. The book's had no boards to bring in since the 14 Nov
// cut, so these four are made up for the kit.
const brine = { cards: [
  { name: "A noble house", seal: { c: "crown", f: "bend" } },
  { name: "A merchants' guild", seal: { c: "anchor", f: "pale" } },
  { name: "An old order", seal: { c: "bell", f: "plain" } },
  { name: "The ones who want out", seal: { c: "chain", f: "quarterly" } },
] };
const turn = book.companion.worlds.turn;
const outcomeOf = (name) => turn.outcomes.find((o) => o.name.toLowerCase() === name)?.text ?? "";
const doesOf = (re) => turn.does.find((x) => re.test(x.text))?.text ?? "";
const glyphWords = { agenda: doesOf(/agenda/i), crew: doesOf(/crew/i) };
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>The kit · Zi’Dara</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#120d18" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // The theme this phone last had open, before anything paints.
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          var k = JSON.parse(localStorage.getItem("zi-kit") || "{}");
          if (k.theme === "light" || k.theme === "paper") root.setAttribute("data-theme", k.theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="kit">
    <Fragment set:html={DEFS} />
    <header class="kbar"><div class="kbar-in" role="toolbar" aria-label="Theme">
      <span class="kbar-name">The kit</span>
      <div class="seg" role="group" aria-label="Theme">
        <button type="button" data-theme-to="dark" aria-pressed="true">Dark</button>
        <button type="button" data-theme-to="light" aria-pressed="false">Light</button>
        <button type="button" data-theme-to="paper" aria-pressed="false">Paper</button>
      </div>
    </div></header>

    <main id="main" class="kpage">
      <header class="khead">
        <p class="eyebrow">The design pass · the kit</p>
        <h1>The kit</h1>
        <p class="lede">Every piece of the game, drawn once and used everywhere: on your phone at the table, in the rules and in the builder. They’re tokens punched out of card, and every die is its real shape, so you can see how big it is before you read it.</p>
        <nav class="kjump" aria-label="On this page">
          <a href="#table">At the table</a><a href="#roll">The roll</a><a href="#dice">Dice</a><a href="#steps">Steps</a><a href="#numbers">Aura</a><a href="#tracks">The tracks</a><a href="#wounds">Blaze and Scars</a><a href="#defend">Defend</a><a href="#tags">Tags</a><a href="#telegraphs">Telegraphs</a><a href="#sigils">Sigils</a><a href="#seals">Seals</a><a href="#rules">In the rules</a>
        </nav>
      </header>

      <!-- At the table: Vesk's numbers with the kit on them -->
      <section id="table" class="ksec">
        <h2>At the table</h2>
        <p class="note">Vesk at the start of a scene, every number off her sheet.</p>
        <div class="vphone">
          <div class="vhead">
            <Fragment set:html={crest(archOf(vesk), { label: `${vesk.name}’s crest: ${archNames(vesk).join(", ")}` })} />
            <div>
              <p class="vname">{vesk.name}</p>
              <p class="vtitle">{vesk.title}</p>
              <p class="vmeta">{archNames(vesk).join(" · ")} · Stride {n.stride}</p>
            </div>
          </div>
          <div class="vtrack">
            <div class="vt die-t"><span class="vl">Stamina</span><Fragment set:html={die(n.stamina.die, { label: `Stamina d${n.stamina.die}` })} /></div>
            <div class="vt die-t"><span class="vl">Confidence</span><Fragment set:html={die(n.confidence.die, { label: `Confidence d${n.confidence.die}` })} /></div>
            <div class="vt die-t"><span class="vl">Resolve</span><Fragment set:html={die(n.resolve.die, { label: `Resolve d${n.resolve.die}` })} /></div>
            <div class="vt"><span class="vl">Aura</span><Fragment set:html={aura(n.aura, n.aura)} /></div>
          </div>
          <div class="vtiles">
            {tilesOf(vesk).map((a) => (
              <div class="vtile">
                <Fragment set:html={diceFor(a.steps, { hide: true })} />
                <div>
                  <p class="tn">{a.name}</p>
                  <p class="ts">{a.root} {vesk.roots[a.root]} and {a.spec}, {diceLabel(stepsToDice(a.steps))}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- The roll -->
      <section id="roll" class="ksec">
        <h2>The roll</h2>
        <p class="note">Bram talks his way past the gate guard. His Soul and his Command are {talk} steps, a d{talk * 2}, against the guard’s d6.</p>
        <div class="vroll lead">
          <div class="vs">
            <figure><Fragment set:html={die(8, { face: 6, label: "Bram’s d8 came up 6" })} /><figcaption>Bram’s d8</figcaption></figure>
            <span class="vsx" aria-hidden="true">against</span>
            <figure><Fragment set:html={die(6, { own: "them", face: 5, state: "low", label: "The guard’s d6 came up 5" })} /><figcaption>The guard’s d6</figcaption></figure>
          </div>
          <p class="verdict" aria-live="polite">Beat it</p>
          <p class="why">His 6 beats the guard’s 5, so he’s through the gate, and a die that wins is 1 Aura.</p>
          <div class="vafter">
            <div><span class="vl">Aura</span><span class="aura-now"><Fragment set:html={aura(n.aura, n.aura)} /></span></div>
          </div>
          <button type="button" class="kbtn primary" data-act="roll">Roll it</button>
        </div>
      </section>

      <!-- Dice -->
      <section id="dice" class="ksec">
        <h2>Dice</h2>
        <p>Every die is its real shape: a d2’s a coin, a d4 a triangle, a d6 a square, a d8 a diamond, a d10 a kite and a d12 a pentagon. A Root and a specialty add up to steps, and the steps make the die, straight off the table in The Core.</p>
        <div class="kladder">
          {SIZES.map((d) => (
            <figure><Fragment set:html={die(d)} /><figcaption><b>{d / 2}</b> {d === 2 ? "step" : "steps"}, a {SHAPES[d].name}</figcaption></figure>
          ))}
        </div>
        <h3>Watch it grow</h3>
        <p>Add a step and the die grows into the next shape. Past 6 steps it starts another die.</p>
        <div class="stepper">
          <button type="button" class="kbtn" data-act="less" aria-label="One step fewer">−</button>
          <output class="stepped" aria-live="polite"><span class="sv">1 step, a d2</span></output>
          <button type="button" class="kbtn" data-act="more" aria-label="One step more">+</button>
        </div>
        <div class="stepdice"><Fragment set:html={diceFor(1)} /></div>
        <h3>Rolled, top face, lost and tied</h3>
        <div class="states">
          <figure><Fragment set:html={die(8)} /><figcaption>To roll</figcaption></figure>
          <figure><Fragment set:html={die(8, { face: 6 })} /><figcaption>Came up 6</figcaption></figure>
          <figure><Fragment set:html={die(8, { face: 8, state: "top", label: "A d8 on its top face, 8, so 1 Aura back" })} /><figcaption>Top face, 1 Aura back</figcaption></figure>
          <figure><Fragment set:html={die(8, { face: 2, state: "low" })} /><figcaption>Lost</figcaption></figure>
          <figure><Fragment set:html={die(8, { face: 5, state: "tie" })} /><figcaption>Tied</figcaption></figure>
        </div>
        <h3>Theirs, and harm</h3>
        <p>The GM’s dice are violet, built from the same steps, so a d10 telegraph is 5 of her budget. Harm is ember.</p>
        <div class="kladder short">
          {[4, 8, 10].map((d) => (
            <figure><Fragment set:html={die(d, { own: "them" })} /><figcaption><b>{d / 2}</b> steps</figcaption></figure>
          ))}
          <figure><Fragment set:html={die(6, { own: "harm", label: "Harm, a d6" })} /><figcaption>Harm</figcaption></figure>
        </div>
        <h3>Past a d12</h3>
        <p>Wren and Bram answer the brute’s club together: her Body, her Archery and her longbow, {wrenShot} steps, and his Shieldwork and his hammer, {bramIn} more, so {combo} steps, {diceLabel(stepsToDice(combo))}.</p>
        <div class="beyond"><Fragment set:html={diceFor(combo)} /></div>
      </section>

      <!-- Steps -->
      <section id="steps" class="ksec">
        <h2>Steps</h2>
        <p>Vesk at the vault door, step by step: one Root, one specialty and the item in her hand, and they make {diceLabel(stepsToDice(lock.steps))}.</p>
        <div class="buildup">
          <ul>
            <li><Fragment set:html={pips(lock.body)} /><span>Her Body, {lock.body}</span></li>
            <li><Fragment set:html={pips(lock.locks)} /><span>Her Locks, {lock.locks}</span></li>
            <li><Fragment set:html={pips(1)} /><span>Her picks</span></li>
          </ul>
          <span class="eq" aria-hidden="true">=</span>
          <Fragment set:html={diceFor(lock.steps)} />
        </div>
      </section>

      <!-- Aura -->
      <section id="numbers" class="ksec">
        <h2>Aura</h2>
        <p>Aura’s the small gold hexes, {n.aura} to start every scene, and no die’s a hex, so they never get mixed up. It’s the one thing you spend, so it’s gold. While you’re acting it can go past {n.aura}, and the hexes past it light up beside the rest till you’ve finished.</p>
        <div class="pairs">
          <div><span class="vl">Full</span><Fragment set:html={aura(n.aura, n.aura)} /></div>
          <div><span class="vl">After 1 Aura</span><Fragment set:html={aura(n.aura - 1, n.aura)} /></div>
          <div><span class="vl">While acting</span><Fragment set:html={aura(n.aura + 2, n.aura + 2)} /></div>
          <div><span class="vl">After 3 for an action</span><Fragment set:html={aura(n.aura - 1, n.aura)} /></div>
        </div>
      </section>

      <!-- The tracks -->
      <section id="tracks" class="ksec">
        <h2>The tracks</h2>
        <p>Stamina for your Body, Confidence for your Mind and Resolve for your Soul. Each starts every character on d12, and every hit that gets through to that Root drops it a size. They’re the dice you roll when the telegraphs land, and they pay for your archetype’s abilities.</p>
        <div class="kladder conf">
          <figure><Fragment set:html={die(12, { label: "Stamina d12, where it starts" })} /><figcaption><b>d12</b> to start</figcaption></figure>
          <figure><Fragment set:html={die(8, { label: "Stamina d8, two hits in" })} /><figcaption><b>d8</b> two hits in</figcaption></figure>
          <figure><Fragment set:html={die(4, { label: "Stamina d4" })} /><figcaption><b>d4</b> worn down</figcaption></figure>
          <figure><Fragment set:html={die(2, { state: "low", label: "Stamina d2, the next hit Blazes" })} /><figcaption><b>d2</b> the next hit Blazes</figcaption></figure>
        </div>
        <div class="swingdemo">
          <span class="swing-now"><Fragment set:html={die(12, { label: "Stamina d12" })} /></span>
          <p class="small" aria-live="polite" data-swing-say>d12, where every character starts.</p>
        </div>
        <div class="kbtns">
          <button type="button" class="kbtn" data-act="win">A hit gets through</button>
          <button type="button" class="kbtn" data-act="miss">Pay for an ability</button>
          <button type="button" class="kbtn" data-act="fresh">The scene ends</button>
        </div>
      </section>

      <!-- Blaze and Scars -->
      <section id="wounds" class="ksec">
        <h2>Blaze and Scars</h2>
        <p>A hit that gets through at d2 and you Blaze: something extraordinary, and then the character dies, your call, or leaves the scene with a Scar on that track. A Scar’s a Catch in your words, and it locks the track’s smallest open size for good.</p>
        <div class="wounddemo">
          <div class="wd"><span class="vl">Stamina</span><span class="wound-now"><Fragment set:html={die(12, { label: "Stamina d12" })} /></span></div>
          <div class="wd"><span class="vl">Scars</span><span class="scars-now"><Fragment set:html={scars(0, { slots: true })} /></span></div>
        </div>
        <div class="kbtns">
          <button type="button" class="kbtn" data-act="hurt">A hit gets through</button>
          <button type="button" class="kbtn" data-act="heal">Up a size</button>
          <button type="button" class="kbtn" data-act="scar" hidden>Take the Scar</button>
        </div>
        <p class="small" aria-live="polite" data-hurt-say>Fresh, on d12.</p>
        <p>With five Scars on a track, only its d12’s left, and the next Blaze there is the last. Nobody Blazes on purpose: paying for an ability never takes a track below its smallest size.</p>
      </section>

      <!-- Defend -->
      <section id="defend" class="ksec">
        <h2>Defend</h2>
        <p>Defend as your action and a Root and a specialty roll with your tracks when the telegraphs land, with your armour as items. Bram’s Body and his Shieldwork, with his plate and his shield, are {bramDefend} steps, {diceLabel(stepsToDice(bramDefend))}, and his Stamina’s d12 rolls with them, so each die stops one telegraph.</p>
        <div class="defends">
          <div class="dfn">
            <ul>
              <li><Fragment set:html={pips(crew.bram.roots.Body)} /><span>His Body</span></li>
              <li><Fragment set:html={pips(specSteps(crew.bram, "Shieldwork"))} /><span>His Shieldwork</span></li>
              {crew.bram.armour.map((a) => <li><Fragment set:html={pips(1)} /><span>{withQuality(a.name, a.quality)}</span></li>)}
            </ul>
            <Fragment set:html={diceFor(bramDefend)} />
          </div>
        </div>
        <p>Armour’s on a Root, and every piece has a box for every hit it can take there instead of the track dropping, from its quality: Common 1, Fine 2 and Masterwork 3. A ticked box is ember, and the last one breaks it.</p>
        <div class="chips">
          {crew.bram.armour.map((a) => <span class="armourline"><span>{withQuality(a.name, a.quality)}, on {a.root}</span><Fragment set:html={boxes(0, a.boxes, { label: `${a.boxes} ${a.boxes === 1 ? "box" : "boxes"}, none ticked` })} /></span>)}
          <span class="armourline"><span>His plate, after a hit</span><Fragment set:html={boxes(1, crew.bram.armour[0]?.boxes ?? 2)} /></span>
        </div>
      </section>

      <!-- Tags and conditions -->
      <section id="tags" class="ksec">
        <h2>Tags and conditions</h2>
        <p>A condition’s a tag carrying a die, and it fades a size every round. One that’s against whoever carries it is ember, and one that’s for them is gold.</p>
        <div class="chips">
          <Fragment set:html={condition("Burning", 8)} />
          <Fragment set:html={condition("Pinned", 6)} />
          <Fragment set:html={condition("Bleeding", 4)} />
        </div>
        <div class="chips">
          <Fragment set:html={condition("Warded", 8, { kind: "for" })} />
          <Fragment set:html={condition("Unseen", 6, { kind: "for" })} />
          <Fragment set:html={condition("Blessed", 12, { kind: "for" })} />
        </div>
        <p>A threat’s tags are violet, and the ones nobody’s found yet stay dashed.</p>
        <div class="chips">
          <Fragment set:html={tag("Reach")} />
          <Fragment set:html={tag("Armoured ×4")} />
          <Fragment set:html={tag("Bound to a Place")} />
          <Fragment set:html={tag("Old")} />
          <Fragment set:html={tag("", { kind: "hidden" })} />
        </div>
      </section>

      <!-- Telegraphs -->
      <section id="telegraphs" class="ksec">
        <h2>Telegraphs</h2>
        <p>What it’s doing, who or what it’s aimed at, and how hard, before anyone rolls.</p>
        <div class="teles">
          <Fragment set:html={telegraph({ who: "The brute", does: "swings his club at Isolde.", at: "Isolde", atCrest: archOf(crew.isolde), d: 8 })} />
          <Fragment set:html={telegraph({ who: "The maid on the stair", does: "slips away to wake the house.", at: "the household clock", aim: "stake", d: 4, one: "If it lands, the household clock drops two sizes." })} />
        </div>
      </section>

      <!-- Sigils and crests -->
      <section id="sigils" class="ksec">
        <h2>Sigils and crests</h2>
        <p>A crest is the Zi’Dara mark made personal: the violet diamond, with your first archetype in the middle. Take an archetype twice and the diamond’s doubled. A second archetype sits in a seal on its edge. It holds a sigil, never a number, so it never reads as a d8.</p>
        <div class="crews">
          {order.map((id) => (
            <figure>
              <Fragment set:html={crest(archOf(crew[id]), { label: `${crew[id].name}’s crest` })} />
              <figcaption><b>{crew[id].name}</b><span>{archNames(crew[id]).join(" and ")}</span></figcaption>
            </figure>
          ))}
        </div>
        <h3>Every archetype</h3>
        <div class="sigils">
          {ARCH.map((a) => (
            <figure>
              <Fragment set:html={crest([a.name], { label: `${a.name}` })} />
              <figcaption>{a.name}</figcaption>
            </figure>
          ))}
        </div>
        <p class="small">At telegraph size: <span class="tiny">{order.map((id) => <Fragment set:html={crest(archOf(crew[id]), { size: "sm", label: crew[id].name })} />)}</span></p>
      </section>

      <!-- Seals and the faction turn's glyphs -->
      <section id="seals" class="ksec">
        <h2>Seals</h2>
        <p>Every faction gets a wax seal. What’s on it says what kind of faction it is, how it’s split tells two of a kind apart, and a small mark on its rim does it when even that’s not enough. They’re told apart by their shapes, never a colour, so violet still means theirs and they print in one ink. The crew sees a faction’s seal with its card, and a blank one till then.</p>
        <h3>What’s on them</h3>
        <p class="note">Each one big, then at the size it is on the web. The builder deals each to the kinds of faction under it.</p>
        <div class="seals">
          {Object.entries(CHARGES).map(([id, c]) => (
            <figure>
              <span class="two"><Fragment set:html={seal({ c: id, f: "plain" }, { label: c.name })} /><Fragment set:html={seal({ c: id, f: "plain" }, { size: "sm" })} /></span>
              <figcaption><b>{c.name}</b><span>{kindsOf(c)}</span></figcaption>
            </figure>
          ))}
        </div>
        <h3>How they’re split</h3>
        <div class="seals fields">
          {Object.entries(FIELDS).map(([id, f]) => (
            <figure><Fragment set:html={seal({ c: "anchor", f: id }, { label: `An anchor, ${f.name.toLowerCase()}` })} /><figcaption><b>{f.name}</b></figcaption></figure>
          ))}
        </div>
        <h3>The marks</h3>
        <div class="seals fields">
          {Object.entries(MARKS).map(([id, m]) => (
            <figure><span class="two"><Fragment set:html={seal({ c: "crown", f: "bend", d: id }, { label: `A crown with ${m.name.toLowerCase()}` })} /><Fragment set:html={seal({ c: "crown", f: "bend", d: id }, { size: "sm" })} /></span><figcaption><b>{m.name}</b></figcaption></figure>
          ))}
        </div>
        <h3>On a board</h3>
        <p class="note">Four factions on a board, and a faction the crew hasn’t met yet.</p>
        <div class="seals board">
          {brine.cards.map((c) => (
            <figure><Fragment set:html={seal(c.seal, { size: "lg", label: c.name })} /><figcaption><b>{c.name}</b></figcaption></figure>
          ))}
          <figure><Fragment set:html={seal(null, { size: "lg", blank: true, label: "A faction the crew hasn’t met" })} /><figcaption><b>Not met yet</b></figcaption></figure>
        </div>
        <h3>The faction turn</h3>
        <p class="note">What each faction’s doing when the turn shows every move at once, before any of them lands.</p>
        <ul class="glyphs">
          {Object.entries(GLYPHS).map(([id, g]) => (
            <li><Fragment set:html={glyph(id)} /><span><b>{g.name}.</b> {glyphWords[id] ?? outcomeOf(id)}</span></li>
          ))}
        </ul>
      </section>

      <!-- In the rules -->
      <section id="rules" class="ksec">
        <h2>In the rules</h2>
        <p class="note">The same pieces in the book’s own example from The Core, headed by Vesk’s crest.</p>
        <div class="rbox">
          <div class="rhead">
            <Fragment set:html={crest(archOf(vesk), { size: "sm", label: "Vesk" })} />
            <span class="rk">Example</span><span class="rn">Building a roll</span>
          </div>
          <p><b>Plainly fits:</b> Vesk’s going over Lord Vane’s roof without a sound. That’s her Body and her Stealth, {roof} steps, and her grappling line’s in her hand, so it’s {roof + 1}: <Fragment set:html={stepsToDice(roof + 1).map((d) => `a ${inline(d)}`).join(" and ")} />.</p>
          <p><b>Making a case:</b> Bram’s chasing a smuggler down the quay. His Body’s {crew.bram.roots.Body}, but Shieldwork’s for holding a line, not running a man down. He says a sergeant knows exactly how a frightened man runs, and pays <Fragment set:html={cost(1)} /> to bring his Soldiering in, so it’s {chase} steps, <Fragment set:html={stepsToDice(chase).map((d) => `a ${inline(d)}`).join(" and ")} />. Without it, he’d have rolled his Body on its own, {crew.bram.roots.Body} steps, <Fragment set:html={stepsToDice(crew.bram.roots.Body).map((d) => `a ${inline(d)}`).join(" and ")} />.</p>
        </div>
      </section>
    </main>

    <script>
      import { die, diceFor, aura, scars, grow, MAX_SCARS } from "../kit/kit.js";
      import { rollDie, stepsToDice, diceLabel, sizeUp, sizeDown } from "../companion/dice.js";

      const root = document.documentElement;
      const still = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
      const keep = () => { try { localStorage.setItem("zi-kit", JSON.stringify({ theme: root.dataset.theme || "dark" })); } catch (e) {} };
      const show = () => {
        document.querySelectorAll("[data-theme-to]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeTo === (root.dataset.theme || "dark"))));
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", root.dataset.theme === "light" ? "#f5f2f7" : root.dataset.theme === "paper" ? "#ffffff" : "#120d18");
      };
      document.querySelectorAll("[data-theme-to]").forEach((b) => b.addEventListener("click", () => {
        if (b.dataset.themeTo === "dark") root.removeAttribute("data-theme");
        else root.dataset.theme = b.dataset.themeTo;
        keep(); show();
      }));
      show();
      const act = (name) => document.querySelector(`[data-act="${name}"]`);

      // A die that changes size grows into its next shape where it sits.
      const swap = (box, from, to, html) => {
        box.innerHTML = html;
        grow(box.querySelector(".zd-die"), from, to);
      };

      // Watch it grow: the steps make the dice, and a die that's still one die
      // grows into its next shape.
      let steps = 1;
      const out = document.querySelector(".stepped .sv");
      const box = document.querySelector(".stepdice");
      const draw = (from) => {
        const was = stepsToDice(from), now = stepsToDice(steps);
        box.innerHTML = diceFor(steps);
        if (was.length === now.length) [...box.querySelectorAll(".zd-die")].forEach((el, i) => grow(el, was[i], now[i]));
        out.textContent = `${steps} ${steps === 1 ? "step" : "steps"}, ${now.length > 1 ? "" : "a "}${diceLabel(now)}`;
      };
      act("more").addEventListener("click", () => { if (steps < 14) { steps++; draw(steps - 1); } });
      act("less").addEventListener("click", () => { if (steps > 1) { steps--; draw(steps + 1); } });

      // The roll: Bram's d8 against the guard's d6, and the Aura it pays: 1
      // for a win and 1 for a top face.
      let bramAura = 4;
      const rollBox = document.querySelector(".vroll");
      const figs = rollBox.querySelectorAll(".vs figure");
      const verdict = rollBox.querySelector(".verdict");
      const why = rollBox.querySelector(".why");
      const auraBox = rollBox.querySelector(".aura-now");
      const put = (fig, html) => { fig.querySelector("svg").outerHTML = html; return fig.querySelector("svg"); };
      act("roll").addEventListener("click", async (e) => {
        const button = e.currentTarget;
        button.disabled = true;
        const mine = rollDie(8), theirs = rollDie(6);
        if (!still()) {
          for (let i = 0; i < 7; i++) {
            put(figs[0], die(8, { face: rollDie(8), spin: true }));
            put(figs[1], die(6, { own: "them", face: rollDie(6), spin: true }));
            await new Promise((r) => setTimeout(r, 70));
          }
        }
        const top = mine === 8;
        const result = mine > theirs ? "beat" : mine === theirs ? "tie" : "under";
        put(figs[1], die(6, { own: "them", face: theirs, state: result === "beat" ? "low" : "", cls: "is-landed", label: `The guard’s d6 came up ${theirs}` }));
        await new Promise((r) => setTimeout(r, still() ? 0 : 140));
        put(figs[0], die(8, { face: mine, state: top ? "top" : result === "under" ? "low" : result === "tie" ? "tie" : "", cls: "is-landed", label: `Bram’s d8 came up ${mine}` }));
        verdict.textContent = result === "beat" ? "Beat it" : result === "tie" ? "A tie" : "Under";
        const gain = (result === "beat" ? 1 : 0) + (top ? 1 : 0);
        const was = bramAura;
        bramAura = Math.min(5, bramAura + gain);
        why.textContent = result === "beat" ? `His ${mine} beats the guard’s ${theirs}, so he’s through the gate` : result === "tie" ? `${mine} each. A tie’s the guard’s, unless Bram pays 1 Aura to make it his` : `The guard’s ${theirs} beats his ${mine}. He’s not getting through like that`;
        why.textContent += gain ? `, and that’s ${gain} Aura${top ? ", with a top face" : ""}.` : ".";
        auraBox.innerHTML = aura(bramAura, 5);
        [...auraBox.querySelectorAll(".zd-chit.on")].slice(was, bramAura).forEach((el) => el.classList.add("is-new"));
        if (bramAura >= 5) bramAura = 3;
        button.disabled = false;
      });

      // A track on its own: a hit through, paying for an ability, and the
      // rest at the end of a scene.
      let track = 12;
      const swingBox = document.querySelector(".swing-now");
      const swingSay = document.querySelector("[data-swing-say]");
      const setTrack = (to, why) => {
        const was = track;
        track = to;
        swap(swingBox, was, track, die(track, { label: `Stamina d${track}`, state: track === 2 ? "low" : "" }));
        swingSay.textContent = `${why} d${track}.${track === 2 ? " The next hit through Blazes." : ""}`;
      };
      act("win").addEventListener("click", () => setTrack(track === 2 ? 12 : sizeDown(track), track === 2 ? "A hit at d2 Blazes, so start again on" : "A hit gets through:"));
      act("miss").addEventListener("click", () => (track > 2 ? setTrack(sizeDown(track), "1 Stamina for an ability:") : (swingSay.textContent = "Paying never takes a track below d2, so it stays on d2.")));
      act("fresh").addEventListener("click", () => {
        if (track >= 12 || track <= 2) return (swingSay.textContent = track >= 12 ? "It’s on d12 already." : "A d2 can’t roll a 4, so it waits for downtime.");
        const r = rollDie(track);
        if (r >= 4) setTrack(sizeUp(track), `It rolls ${r}, a 4 or more, so it comes up to`);
        else swingSay.textContent = `It rolls ${r}, under 4, so it stays on d${track}.`;
      });

      // Blaze and Scars: hits drop Stamina a size, a hit at its smallest open
      // size Blazes, and each Scar locks the smallest size left.
      let wound = 12, scarred = 0, blazed = false;
      const woundBox = document.querySelector(".wound-now");
      const scarBox = document.querySelector(".scars-now");
      const say = document.querySelector("[data-hurt-say]");
      const scarButton = act("scar");
      const floor = () => Math.min(12, 2 + 2 * scarred);
      const drawWound = (wasWound, fresh) => {
        swap(woundBox, wasWound, wound, die(wound, { label: `Stamina d${wound}`, state: wound <= floor() ? "low" : "" }));
        scarBox.innerHTML = scars(scarred, { slots: true });
        if (fresh) scarBox.querySelectorAll("i.on")[scarred - 1]?.classList.add("is-new");
        scarButton.hidden = !blazed;
        scarButton.textContent = scarred >= MAX_SCARS ? "Start again" : "Take the Scar";
        act("hurt").disabled = blazed;
      };
      act("hurt").addEventListener("click", () => {
        if (blazed) return;
        const w = wound;
        if (wound <= floor()) {
          blazed = true;
          say.textContent = `A hit at d${wound}, so she Blazes. She declares something extraordinary and it happens, no roll.${scarred >= MAX_SCARS ? " With five Scars, it’s her last." : " Then she leaves the scene, and her Stamina takes a Scar."}`;
          drawWound(w, false);
          return;
        }
        wound = sizeDown(wound);
        say.textContent = `A hit gets through, and her Stamina’s a d${wound}${wound <= floor() ? ". The next one Blazes" : ""}.`;
        drawWound(w, false);
      });
      act("heal").addEventListener("click", () => {
        const w = wound;
        if (wound >= 12) { say.textContent = "It’s on d12 already."; return; }
        wound = sizeUp(wound);
        blazed = false;
        say.textContent = `Up a size, to d${wound}.`;
        drawWound(w, false);
      });
      scarButton.addEventListener("click", () => {
        const w = wound;
        if (scarred >= MAX_SCARS) {
          scarred = 0; wound = 12; blazed = false;
          say.textContent = "Fresh, on d12.";
          drawWound(w, false);
          return;
        }
        scarred++;
        blazed = false;
        wound = floor();
        say.textContent = scarred === MAX_SCARS ? "Five Scars, so only her d12’s left, and her next Blaze is her last." : `The hit’s a Scar now, a Catch in her words. It locks her d${floor() - 2}, and her Stamina’s on d${wound}.`;
        drawWound(w, true);
      });
    </script>
  </body>
</html>

