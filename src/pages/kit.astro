---
// The kit: every game object, drawn once in the Struck look Mo picked on
// 26 Oct (notes/design-26oct.md, Piece 1), on the current rules. It reads the
// crew off the chapter, like the companion does, so every number here is the
// book's. Not linked from anywhere, and kept out of search and the offline
// cache.
import "@fontsource/cinzel/600.css";
import "@fontsource/cinzel/700.css";
import "@fontsource/alegreya-sans/400.css";
import "@fontsource/alegreya-sans/400-italic.css";
import "@fontsource/alegreya-sans/700.css";
import "@fontsource/alegreya-sans/700-italic.css";
import "@fontsource/alegreya-sans/800.css";
import "../styles/site.css";
import "../styles/kit.css";
import book from "../generated/book.json";
import { die, diceFor, inline, pips, aura, resolve, scars, boxes, condition, tag, crest, telegraph, cost, DEFS, SIGILS, SHAPES, SIZES } from "../kit/kit.js";
import { diceLabel, stepsToDice } from "../companion/dice.js";
import { withQuality } from "../companion/armour.js";

const crew = Object.fromEntries(book.crew.map((c) => [c.id, c]));
const archOf = (c) => c.titles.map((t) => t.archetype);
const ARCH = book.companion.build.archetypes;
for (const a of ARCH) if (!SIGILS[a.name]) throw new Error(`The kit has no sigil for ${a.name}. Draw one in src/kit/sigils.js.`);
const vesk = crew.vesk;
const lineOf = (c, key) => c.lines.find((l) => l.key === key);
const said = (l) => (l.kind === "title" ? `Title: ${l.label}` : l.label);
const sneak = vesk.actions.find((a) => a.name === "Sneak");
const sneakLines = sneak.lines.map((k) => lineOf(vesk, k));
const wren = crew.wren.actions.find((a) => a.name === "Fight");
const bram = crew.bram.actions.find((a) => a.name === "Fight");
const bramDefend = crew.bram.actions.find((a) => a.name === "Defend");
const bramDefendLines = bramDefend.lines.map((k) => lineOf(crew.bram, k));
const doubled = 1 + 2 * bramDefend.lines.length;
const combo = wren.steps + bram.steps;
const order = ["vesk", "dorrie", "bram", "isolde", "wren", "ash"];
const n = vesk.numbers;
const isolde = crew.isolde.numbers;
// A Defend for the table: Vesk's, read off her sheet.
const veskDefend = vesk.actions.find((a) => a.name === "Defend");
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>The kit · Zi’Dara</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#120d18" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // The theme this phone last had open, before anything paints.
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          var k = JSON.parse(localStorage.getItem("zi-kit") || "{}");
          if (k.theme === "light" || k.theme === "paper") root.setAttribute("data-theme", k.theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="kit">
    <Fragment set:html={DEFS} />
    <header class="kbar"><div class="kbar-in" role="toolbar" aria-label="Theme">
      <span class="kbar-name">The kit</span>
      <div class="seg" role="group" aria-label="Theme">
        <button type="button" data-theme-to="dark" aria-pressed="true">Dark</button>
        <button type="button" data-theme-to="light" aria-pressed="false">Light</button>
        <button type="button" data-theme-to="paper" aria-pressed="false">Paper</button>
      </div>
    </div></header>

    <main id="main" class="kpage">
      <header class="khead">
        <p class="eyebrow">The design pass · the kit</p>
        <h1>The kit</h1>
        <p class="lede">Every piece of the game, drawn once and used everywhere: on your phone at the table, in the rules and in the builder. They’re tokens punched out of card, and every die is its real shape, so you can see how big it is before you read it.</p>
        <nav class="kjump" aria-label="On this page">
          <a href="#table">At the table</a><a href="#roll">The roll</a><a href="#dice">Dice</a><a href="#steps">Steps</a><a href="#numbers">Aura and Resolve</a><a href="#confidence">Confidence</a><a href="#wounds">Wounds</a><a href="#defend">Defend</a><a href="#tags">Tags</a><a href="#telegraphs">Telegraphs</a><a href="#sigils">Sigils</a><a href="#rules">In the rules</a>
        </nav>
      </header>

      <!-- At the table: Vesk's numbers with the kit on them -->
      <section id="table" class="ksec">
        <h2>At the table</h2>
        <p class="note">Vesk at the start of a scene, every number off her sheet.</p>
        <div class="vphone">
          <div class="vhead">
            <Fragment set:html={crest(archOf(vesk), { label: `${vesk.name}’s crest: ${vesk.archetypes.join(", ")}` })} />
            <div>
              <p class="vname">{vesk.name}</p>
              <p class="vtitle">{vesk.title}</p>
              <p class="vmeta">{vesk.archetypes.join(" · ")} · Stride {n.stride}</p>
            </div>
          </div>
          <div class="vtrack">
            <div class="vt die-t"><span class="vl">Confidence</span><Fragment set:html={die(n.confidence, { label: `Confidence d${n.confidence}` })} /></div>
            <div class="vt die-t"><span class="vl">Wound die</span><Fragment set:html={die(n.wound, { own: "harm", label: `Wound die d${n.wound}` })} /></div>
            <div class="vt"><span class="vl">Aura</span><Fragment set:html={aura(n.aura, n.aura)} /></div>
            <div class="vt"><span class="vl">Resolve</span><Fragment set:html={resolve(n.resolve, n.resolve)} /></div>
          </div>
          <div class="vtiles">
            {vesk.actions.map((a) => (
              <div class="vtile">
                <Fragment set:html={diceFor(a.steps, { hide: true })} />
                <div>
                  <p class="tn">{a.name}</p>
                  <p class="ts">{a.steps} {a.steps === 1 ? "step" : "steps"}, {diceLabel(stepsToDice(a.steps))}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- The roll -->
      <section id="roll" class="ksec">
        <h2>The roll</h2>
        <p class="note">Vesk slips past the guard on Lord Vane’s roof. Her Sneak’s {sneak.steps} steps, a {sneak.die}, against the guard’s d6.</p>
        <div class="vroll lead">
          <div class="vs">
            <figure><Fragment set:html={die(8, { face: 6, label: "Vesk’s d8 came up 6" })} /><figcaption>Vesk’s d8</figcaption></figure>
            <span class="vsx" aria-hidden="true">against</span>
            <figure><Fragment set:html={die(6, { own: "them", face: 5, state: "low", label: "The guard’s d6 came up 5" })} /><figcaption>The guard’s d6</figcaption></figure>
          </div>
          <p class="verdict" aria-live="polite">Beat it</p>
          <p class="why">Her 6 beats his 5, so she’s past him, and her Confidence goes up a size.</p>
          <div class="vafter">
            <div><span class="vl">Confidence</span><span class="conf-now"><Fragment set:html={die(8, { label: "Confidence d8" })} /></span></div>
            <div><span class="vl">Aura</span><span class="aura-now"><Fragment set:html={aura(n.aura - 1, n.aura)} /></span></div>
          </div>
          <button type="button" class="kbtn primary" data-act="roll">Roll it</button>
        </div>
      </section>

      <!-- Dice -->
      <section id="dice" class="ksec">
        <h2>Dice</h2>
        <p>Every die is its real shape: a d2’s a coin, a d4 a triangle, a d6 a square, a d8 a diamond, a d10 a kite and a d12 a pentagon. Every line on a set action is a step, and the steps make the die, straight off the table in The Core.</p>
        <div class="kladder">
          {SIZES.map((d) => (
            <figure><Fragment set:html={die(d)} /><figcaption><b>{d / 2}</b> {d === 2 ? "step" : "steps"}, a {SHAPES[d].name}</figcaption></figure>
          ))}
        </div>
        <h3>Watch it grow</h3>
        <p>Add a step and the die grows into the next shape. Past 6 steps it starts another die.</p>
        <div class="stepper">
          <button type="button" class="kbtn" data-act="less" aria-label="One step fewer">−</button>
          <output class="stepped" aria-live="polite"><span class="sv">1 step, a d2</span></output>
          <button type="button" class="kbtn" data-act="more" aria-label="One step more">+</button>
        </div>
        <div class="stepdice"><Fragment set:html={diceFor(1)} /></div>
        <h3>Rolled, top face, lost and tied</h3>
        <div class="states">
          <figure><Fragment set:html={die(8)} /><figcaption>To roll</figcaption></figure>
          <figure><Fragment set:html={die(8, { face: 6 })} /><figcaption>Came up 6</figcaption></figure>
          <figure><Fragment set:html={die(8, { face: 8, state: "top", label: "A d8 on its top face, 8, so 1 Aura back" })} /><figcaption>Top face, 1 Aura back</figcaption></figure>
          <figure><Fragment set:html={die(8, { face: 2, state: "low" })} /><figcaption>Lost</figcaption></figure>
          <figure><Fragment set:html={die(8, { face: 5, state: "tie" })} /><figcaption>Tied</figcaption></figure>
        </div>
        <h3>Theirs, and harm</h3>
        <p>The GM’s dice are violet, built from the same steps, so a d10 telegraph is 5 of her budget. Harm is ember, like your wound die.</p>
        <div class="kladder short">
          {[4, 8, 10].map((d) => (
            <figure><Fragment set:html={die(d, { own: "them" })} /><figcaption><b>{d / 2}</b> steps</figcaption></figure>
          ))}
          <figure><Fragment set:html={die(6, { own: "harm", label: "A wound die, d6" })} /><figcaption>A wound die</figcaption></figure>
        </div>
        <h3>Past a d12</h3>
        <p>Wren and Bram put their Fights in together on the brute’s club: {wren.steps} steps and {bram.steps}, so {combo} steps, a {diceLabel(stepsToDice(combo))}.</p>
        <div class="beyond"><Fragment set:html={diceFor(combo)} /></div>
      </section>

      <!-- Steps -->
      <section id="steps" class="ksec">
        <h2>Steps</h2>
        <p>Vesk’s Sneak, line by line. Each line’s a step, the action’s one more, and they make her {sneak.die}.</p>
        <div class="buildup">
          <ul>
            {sneakLines.map((l) => (
              <li><Fragment set:html={pips(1)} /><span>{l.kind === "title" ? <>Her first Title, <i>{l.label}</i></> : l.kind === "permission" ? <i>{l.label}</i> : l.label}</span></li>
            ))}
            <li><Fragment set:html={pips(1)} /><span>The action</span></li>
          </ul>
          <span class="eq" aria-hidden="true">=</span>
          <Fragment set:html={diceFor(sneak.steps)} />
        </div>
      </section>

      <!-- Aura and Resolve -->
      <section id="numbers" class="ksec">
        <h2>Aura and Resolve</h2>
        <p>Aura’s the small gold hexes, {n.aura} to start every scene, and no die’s a hex, so they never get mixed up. Resolve’s the cut gems, one for every Title, with a flat top so it never looks like a d8. Both are yours to spend, so both are gold.</p>
        <div class="pairs">
          <div><span class="vl">Full</span><Fragment set:html={aura(n.aura, n.aura)} /></div>
          <div><span class="vl">After 1 Aura</span><Fragment set:html={aura(n.aura - 1, n.aura)} /></div>
          <div><span class="vl">Resolve</span><Fragment set:html={resolve(n.resolve, n.resolve)} /></div>
          <div><span class="vl">After 1 Resolve</span><Fragment set:html={resolve(n.resolve - 1, n.resolve)} /></div>
        </div>
        <div class="gemvs">
          <figure><Fragment set:html={resolve(1, 1)} /><figcaption>Resolve</figcaption></figure>
          <figure><Fragment set:html={die(8, { hide: true })} /><figcaption>A d8</figcaption></figure>
        </div>
      </section>

      <!-- Confidence -->
      <section id="confidence" class="ksec">
        <h2>Confidence</h2>
        <p>It starts every scene on d6 and moves a size at a time. A win puts it up a size, and so does every telegraph your defence stops. A miss with every die takes it down a size, and so does every step your wound die goes up.</p>
        <div class="kladder conf">
          <figure><Fragment set:html={die(2, { label: "Confidence d2, shaken" })} /><figcaption><b>d2</b> shaken</figcaption></figure>
          <figure><Fragment set:html={die(6, { label: "Confidence d6, every scene starts here" })} /><figcaption><b>d6</b> every scene</figcaption></figure>
          <figure><Fragment set:html={die(isolde.confidence, { label: `Confidence d${isolde.confidence}, Isolde’s Iron Will` })} /><figcaption><b>d{isolde.confidence}</b> Isolde’s {isolde.confidenceNote}</figcaption></figure>
          <figure><Fragment set:html={die(12, { label: "Confidence d12, fired up" })} /><figcaption><b>d12</b> fired up</figcaption></figure>
        </div>
        <div class="swingdemo">
          <span class="swing-now"><Fragment set:html={die(6, { label: "Confidence d6" })} /></span>
          <p class="small" aria-live="polite" data-swing-say>d6, where every scene starts.</p>
        </div>
        <div class="kbtns">
          <button type="button" class="kbtn" data-act="win">One of her dice wins</button>
          <button type="button" class="kbtn" data-act="miss">Every die misses</button>
          <button type="button" class="kbtn" data-act="fresh">New scene</button>
        </div>
      </section>

      <!-- Wounds and Scars -->
      <section id="wounds" class="ksec">
        <h2>The wound die and Scars</h2>
        <p>Your wound die’s how hurt you are, a die like any other in ember. It starts at d2, and every Hurt puts it up a size and takes your Confidence down one. Take a Hurt at d12 and you Blaze, and the wound becomes a Scar, written in as a Catch beside it.</p>
        <div class="wounddemo">
          <div class="wd"><span class="vl">Wound die</span><span class="wound-now"><Fragment set:html={die(2, { own: "harm", label: "Wound die d2" })} /></span></div>
          <div class="wd"><span class="vl">Scars</span><span class="scars-now"><Fragment set:html={scars(0, { slots: true })} /></span></div>
          <div class="wd"><span class="vl">Confidence</span><span class="wconf-now"><Fragment set:html={die(6, { label: "Confidence d6" })} /></span></div>
        </div>
        <div class="kbtns">
          <button type="button" class="kbtn" data-act="hurt">Take a Hurt</button>
          <button type="button" class="kbtn" data-act="heal">Heal: down a size</button>
          <button type="button" class="kbtn" data-act="scar" hidden>Take the Scar</button>
        </div>
        <p class="small" aria-live="polite" data-hurt-say>Fresh, on d2.</p>
        <p>Each Scar starts the wound die a size bigger, and nothing heals it below them. With five, the next Blaze is the last. Bram’s <i>Unyielding</i> means the first Hurt he takes each scene doesn’t move his.</p>
        <div class="chips">
          <span class="scarline"><Fragment set:html={die(4, { own: "harm", label: "Wound die d4, with one Scar" })} /><Fragment set:html={scars(1)} /><span><i>a spear through the shoulder</i></span></span>
        </div>
      </section>

      <!-- Defend -->
      <section id="defend" class="ksec">
        <h2>Defend</h2>
        <p>Defend’s a set action like the rest, and plain armour, a shield and a helmet are lines on it, a step each. Bram’s plate and shield, his first Title and the action make his Defend {bramDefend.steps} steps, a {bramDefend.die}. When he spends his action to Defend, every line counts twice: {doubled} steps, a {diceLabel(stepsToDice(doubled))}, and each die stops one telegraph.</p>
        <div class="defends">
          <div class="dfn">
            <ul>
              {bramDefendLines.map((l) => <li><Fragment set:html={pips(1)} /><span>{said(l)}</span></li>)}
              <li><Fragment set:html={pips(1)} /><span>The action</span></li>
            </ul>
            <Fragment set:html={diceFor(bramDefend.steps)} />
          </div>
          <div class="dfn">
            <ul>
              {bramDefendLines.map((l) => <li><Fragment set:html={pips(2)} /><span>{said(l)}, twice</span></li>)}
              <li><Fragment set:html={pips(1)} /><span>The action</span></li>
            </ul>
            <Fragment set:html={diceFor(doubled)} />
          </div>
        </div>
        <p class="small">Vesk’s is her worn leathers and the action, {veskDefend.steps} steps, a <Fragment set:html={inline(Number(veskDefend.die.slice(1)))} />.</p>
        <p>Every piece of armour has a box for every blow it can take for you, from its quality: Common 1, Fine 2 and Masterwork 3. A ticked box is ember, and the last one breaks it.</p>
        <div class="chips">
          {crew.bram.armour.map((a) => <span class="armourline"><span>{withQuality(a.name, a.quality)}</span><Fragment set:html={boxes(0, a.boxes, { label: `${a.boxes} ${a.boxes === 1 ? "box" : "boxes"}, none ticked` })} /></span>)}
          <span class="armourline"><span>His plate, after a blow</span><Fragment set:html={boxes(1, crew.bram.armour[0]?.boxes ?? 2)} /></span>
        </div>
      </section>

      <!-- Tags and conditions -->
      <section id="tags" class="ksec">
        <h2>Tags and conditions</h2>
        <p>A condition’s a tag carrying a die, and it fades a size every round. One that’s against whoever carries it is ember, and one that’s for them is gold.</p>
        <div class="chips">
          <Fragment set:html={condition("Burning", 8)} />
          <Fragment set:html={condition("Pinned", 6)} />
          <Fragment set:html={condition("Bleeding", 4)} />
        </div>
        <div class="chips">
          <Fragment set:html={condition("Warded", 8, { kind: "for" })} />
          <Fragment set:html={condition("Unseen", 6, { kind: "for" })} />
          <Fragment set:html={condition("Blessed", 12, { kind: "for" })} />
        </div>
        <p>A threat’s tags are violet, and the ones nobody’s found yet stay dashed.</p>
        <div class="chips">
          <Fragment set:html={tag("Reach")} />
          <Fragment set:html={tag("Armoured ×4")} />
          <Fragment set:html={tag("Bound to a Place")} />
          <Fragment set:html={tag("Old")} />
          <Fragment set:html={tag("", { kind: "hidden" })} />
        </div>
      </section>

      <!-- Telegraphs -->
      <section id="telegraphs" class="ksec">
        <h2>Telegraphs</h2>
        <p>What it’s doing, who or what it’s aimed at, and how hard, before anyone rolls.</p>
        <div class="teles">
          <Fragment set:html={telegraph({ who: "The brute", does: "swings his club at Isolde.", at: "Isolde", atCrest: archOf(crew.isolde), d: 8 })} />
          <Fragment set:html={telegraph({ who: "The maid on the stair", does: "slips away to wake the house.", at: "the household clock", aim: "stake", d: 4, one: "If it lands, the household clock drops two sizes." })} />
        </div>
      </section>

      <!-- Sigils and crests -->
      <section id="sigils" class="ksec">
        <h2>Sigils and crests</h2>
        <p>A crest is the Zi’Dara mark made personal: the violet diamond, with your first Title’s archetype in the middle. Take an archetype twice and the diamond’s doubled. A second archetype sits in a seal on its edge. It holds a sigil, never a number, so it never reads as a d8.</p>
        <div class="crews">
          {order.map((id) => (
            <figure>
              <Fragment set:html={crest(archOf(crew[id]), { label: `${crew[id].name}’s crest` })} />
              <figcaption><b>{crew[id].name}</b><span>{crew[id].archetypes.join(" and ")}</span></figcaption>
            </figure>
          ))}
        </div>
        <h3>Every archetype</h3>
        <div class="sigils">
          {ARCH.map((a) => (
            <figure>
              <Fragment set:html={crest([a.name], { label: `${a.name}` })} />
              <figcaption>{a.name}</figcaption>
            </figure>
          ))}
        </div>
        <p class="small">At telegraph size: <span class="tiny">{order.map((id) => <Fragment set:html={crest(archOf(crew[id]), { size: "sm", label: crew[id].name })} />)}</span></p>
      </section>

      <!-- In the rules -->
      <section id="rules" class="ksec">
        <h2>In the rules</h2>
        <p class="note">The same pieces in the book’s own example from The Core, headed by Vesk’s crest.</p>
        <div class="rbox">
          <div class="rhead">
            <Fragment set:html={crest(archOf(vesk), { size: "sm", label: "Vesk" })} />
            <span class="rk">Example</span><span class="rn">Building a roll</span>
          </div>
          <p><b>Bringing one in:</b> Vesk’s going over Lord Vane’s roof without a sound. She starts from her Sneak: her first Title, <i>move unseen</i> and Silent Step, with the action, 4 steps, a <Fragment set:html={inline(8)} />. Her grappling line fits too, but it’s on her Move, not her Sneak, so bringing it in costs <Fragment set:html={cost(1)} />. That’s 5 steps, a <Fragment set:html={inline(10)} />.</p>
          <p><b>Leaving one out:</b> Bram swings at a smuggler who’s running for the door. His Fight is his first Title, <i>hold the line</i> and his war hammer, with the action, 4 steps. He isn’t holding any line, so he leaves that one out: 3 steps, a <Fragment set:html={inline(6)} />.</p>
        </div>
      </section>
    </main>

    <script>
      import { die, diceFor, aura, scars, grow, MAX_SCARS } from "../kit/kit.js";
      import { rollDie, stepsToDice, diceLabel, sizeUp, sizeDown } from "../companion/dice.js";

      const root = document.documentElement;
      const still = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
      const keep = () => { try { localStorage.setItem("zi-kit", JSON.stringify({ theme: root.dataset.theme || "dark" })); } catch (e) {} };
      const show = () => {
        document.querySelectorAll("[data-theme-to]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeTo === (root.dataset.theme || "dark"))));
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", root.dataset.theme === "light" ? "#f5f2f7" : root.dataset.theme === "paper" ? "#ffffff" : "#120d18");
      };
      document.querySelectorAll("[data-theme-to]").forEach((b) => b.addEventListener("click", () => {
        if (b.dataset.themeTo === "dark") root.removeAttribute("data-theme");
        else root.dataset.theme = b.dataset.themeTo;
        keep(); show();
      }));
      show();
      const act = (name) => document.querySelector(`[data-act="${name}"]`);

      // A die that changes size grows into its next shape where it sits.
      const swap = (box, from, to, html) => {
        box.innerHTML = html;
        grow(box.querySelector(".zd-die"), from, to);
      };

      // Watch it grow: the steps make the dice, and a die that's still one die
      // grows into its next shape.
      let steps = 1;
      const out = document.querySelector(".stepped .sv");
      const box = document.querySelector(".stepdice");
      const draw = (from) => {
        const was = stepsToDice(from), now = stepsToDice(steps);
        box.innerHTML = diceFor(steps);
        if (was.length === now.length) [...box.querySelectorAll(".zd-die")].forEach((el, i) => grow(el, was[i], now[i]));
        out.textContent = `${steps} ${steps === 1 ? "step" : "steps"}, ${now.length > 1 ? "" : "a "}${diceLabel(now)}`;
      };
      act("more").addEventListener("click", () => { if (steps < 14) { steps++; draw(steps - 1); } });
      act("less").addEventListener("click", () => { if (steps > 1) { steps--; draw(steps + 1); } });

      // The roll: Vesk's d8 against the guard's d6, and her Confidence swings.
      let veskAura = 4;
      let veskConf = 6;
      const rollBox = document.querySelector(".vroll");
      const figs = rollBox.querySelectorAll(".vs figure");
      const verdict = rollBox.querySelector(".verdict");
      const why = rollBox.querySelector(".why");
      const auraBox = rollBox.querySelector(".aura-now");
      const confBox = rollBox.querySelector(".conf-now");
      const put = (fig, html) => { fig.querySelector("svg").outerHTML = html; return fig.querySelector("svg"); };
      act("roll").addEventListener("click", async (e) => {
        const button = e.currentTarget;
        button.disabled = true;
        const mine = rollDie(8), theirs = rollDie(6);
        if (!still()) {
          for (let i = 0; i < 7; i++) {
            put(figs[0], die(8, { face: rollDie(8), spin: true }));
            put(figs[1], die(6, { own: "them", face: rollDie(6), spin: true }));
            await new Promise((r) => setTimeout(r, 70));
          }
        }
        const top = mine === 8;
        const result = mine > theirs ? "beat" : mine === theirs ? "tie" : "under";
        put(figs[1], die(6, { own: "them", face: theirs, state: result === "beat" ? "low" : "", cls: "is-landed", label: `The guard’s d6 came up ${theirs}` }));
        await new Promise((r) => setTimeout(r, still() ? 0 : 140));
        put(figs[0], die(8, { face: mine, state: top ? "top" : result === "under" ? "low" : result === "tie" ? "tie" : "", cls: "is-landed", label: `Vesk’s d8 came up ${mine}` }));
        verdict.textContent = result === "beat" ? "Beat it" : result === "tie" ? "A tie" : "Under";
        const was = veskConf;
        veskConf = result === "beat" ? sizeUp(was) : result === "under" ? sizeDown(was) : was;
        const swing = veskConf > was ? `, and her Confidence goes up to d${veskConf}` : veskConf < was ? `, and her Confidence drops to d${veskConf}` : was === 12 && result === "beat" ? ", and her Confidence is on d12 already" : "";
        why.textContent = result === "beat" ? `Her ${mine} beats his ${theirs}, so she’s past him${swing}.` : result === "tie" ? `${mine} each. A tie’s his, unless she pays 1 Aura to make it hers.` : `His ${theirs} beats her ${mine}. He’s seen something${swing}.`;
        swap(confBox, was, veskConf, die(veskConf, { label: `Confidence d${veskConf}` }));
        if (top && veskAura < 5) {
          veskAura++;
          auraBox.innerHTML = aura(veskAura, 5);
          auraBox.querySelectorAll(".zd-chit.on")[veskAura - 1]?.classList.add("is-new");
          why.textContent += " Her 8’s a top face, so she gets 1 Aura back.";
        } else if (top) why.textContent += " Her 8’s a top face, and her Aura’s full, so she can give it to a friend.";
        button.disabled = false;
      });

      // Confidence on its own: a win, a miss and a new scene.
      let conf = 6;
      const swingBox = document.querySelector(".swing-now");
      const swingSay = document.querySelector("[data-swing-say]");
      const mood = (d) => (d === 2 ? "d2, so she’s shaken: no action at what the scene’s about without 1 Resolve." : d === 12 ? "d12, so she’s fired up: she can cash it in for an extra action." : `d${d}.`);
      const setConf = (to, why) => {
        const was = conf;
        conf = to;
        swap(swingBox, was, conf, die(conf, { label: `Confidence d${conf}` }));
        swingSay.textContent = `${why} ${mood(conf)}`;
      };
      act("win").addEventListener("click", () => setConf(sizeUp(conf), conf === 12 ? "Already as high as it goes:" : "Up a size:"));
      act("miss").addEventListener("click", () => setConf(sizeDown(conf), conf === 2 ? "As low as it goes:" : "Down a size:"));
      act("fresh").addEventListener("click", () => setConf(6, "A new scene starts it on"));

      // The wound die: every Hurt up a size and Confidence down one, a Blaze at
      // d12, and the Scar it leaves.
      let wound = 2, scarred = 0, wconf = 6, blazed = false;
      const woundBox = document.querySelector(".wound-now");
      const scarBox = document.querySelector(".scars-now");
      const wconfBox = document.querySelector(".wconf-now");
      const say = document.querySelector("[data-hurt-say]");
      const scarButton = act("scar");
      const floor = () => Math.min(12, 2 + 2 * scarred);
      const drawWound = (wasWound, wasConf, fresh) => {
        swap(woundBox, wasWound, wound, die(wound, { own: "harm", label: `Wound die d${wound}` }));
        swap(wconfBox, wasConf, wconf, die(wconf, { label: `Confidence d${wconf}` }));
        scarBox.innerHTML = scars(scarred, { slots: true });
        if (fresh) scarBox.querySelectorAll("i.on")[scarred - 1]?.classList.add("is-new");
        scarButton.hidden = !blazed;
        scarButton.textContent = scarred >= MAX_SCARS ? "Start again" : "Take the Scar";
        act("hurt").disabled = blazed;
      };
      act("hurt").addEventListener("click", () => {
        if (blazed) return;
        const w = wound, c = wconf;
        if (wound >= 12) {
          blazed = true;
          say.textContent = `A Hurt at d12, so she Blazes. She declares something extraordinary and it happens, no roll.${scarred >= MAX_SCARS ? " With five Scars, it’s her last." : " Then she leaves the scene, and the wound becomes a Scar."}`;
          drawWound(w, c, false);
          return;
        }
        wound = sizeUp(wound);
        wconf = sizeDown(wconf);
        say.textContent = `A Hurt: her wound die’s a d${wound}${wound === 12 ? ", and the next one Blazes" : ""}, and her Confidence ${wconf < c ? `drops to d${wconf}` : "is on d2 already"}.`;
        drawWound(w, c, false);
      });
      act("heal").addEventListener("click", () => {
        const w = wound;
        if (wound <= floor()) { say.textContent = `Nothing heals her below d${floor()}${scarred ? ", where her Scars keep it" : ""}.`; return; }
        wound = sizeDown(wound);
        blazed = false;
        say.textContent = `A heal brings it down to d${wound}.`;
        drawWound(w, wconf, false);
      });
      scarButton.addEventListener("click", () => {
        const w = wound, c = wconf;
        if (scarred >= MAX_SCARS) {
          scarred = 0; wound = 2; wconf = 6; blazed = false;
          say.textContent = "Fresh, on d2.";
          drawWound(w, c, false);
          return;
        }
        scarred++;
        blazed = false;
        wound = floor();
        wconf = 6;
        say.textContent = scarred === MAX_SCARS ? "Five Scars, so she’s scarred out: her wound die never goes below d12, and her next Blaze is her last." : `The wound’s a Scar now, a Catch in her words. Her wound die drops back to d${wound}, and it never goes below that. A new scene starts her Confidence on d6.`;
        drawWound(w, c, true);
      });
    </script>
  </body>
</html>

