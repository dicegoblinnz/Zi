{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Worker's name in the Cloudflare dashboard has to match this.
  "name": "zidara",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
