{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Worker is called "zi" in the Cloudflare dashboard, with zidara.world
  // attached as a custom domain. Keep this name the same as the dashboard's.
  "name": "zi",
  "compatibility_date": "2026-10-13",
  // Better Auth keeps track of each request with node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  // Pages and files are served straight from dist/. Only /api/ (sign-in and
  // accounts) runs the Worker, so the rest costs nothing and works as before.
  "main": "src/worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // The hosts sign-in works on. Add a Preview's host (comma between) to sign
    // in there too, and give Google and Discord its callback addresses.
    "AUTH_HOSTS": "zidara.world",
    // Google's id for the site's sign-in. It isn't secret (it's in every
    // sign-in link). The secret half, GOOGLE_CLIENT_SECRET, is a Worker secret.
    "GOOGLE_CLIENT_ID": "157837358914-2quopnsqqo45bkcrhgnt3tld0g7oahch.apps.googleusercontent.com"
  },
  // Accounts live in the D1 database zi. Its tables come from migrations/,
  // applied by `npx wrangler d1 migrations apply DB --remote`, which
  // npm run deploy does before each deploy from main. Previews share this
  // database, so they never run migrations, and sign-in stays off there until
  // they get a database of their own.
  "d1_databases": [{ "binding": "DB", "database_name": "zi", "database_id": "8d3df3f6-384f-4aa0-8b18-e2d8540ed652", "migrations_dir": "migrations" }],
  // The live table: one Durable Object for each campaign, holding its round of
  // telegraphs in its own SQLite (src/worker/table.js). SQLite-backed objects
  // run on the Workers Free plan. wrangler deploy applies these migrations
  // itself, separately from D1's.
  "durable_objects": { "bindings": [{ "name": "TABLE", "class_name": "Table" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Table"] }],
  // Branches other than main build a Preview with `npx wrangler preview`,
  // which won't run without this block. Each Preview gets its own live tables,
  // and the binding has to be named again here for the Worker to see it.
  "previews": {
    "durable_objects": { "bindings": [{ "name": "TABLE", "class_name": "Table" }] }
  }
}
